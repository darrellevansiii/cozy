# Shopify Storefront API Configuration
# Get these from your Shopify Admin: Apps → Develop apps → Create custom app

# Your Shopify store domain (e.g., your-store.myshopify.com)
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com

# Your Storefront API access token
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token-here

# Instructions:
# 1. Copy this file to .env (don't commit .env to git!)
# 2. Replace the placeholder values with your actual Shopify credentials
# 3. Restart your dev server after making changes
